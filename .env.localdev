# server settings
CORS_ORIGINS=http://localhost:8000
DATABASE_PATH=music-server.db
JWT_SECRET=a-different-secret-key-for-jwt-sessions
NODE_ENV=development
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7000
SWAGGER_ENABLED=true
TZ=UTC

# authentication cert
PUBLIC_KEY_PATH=${PWD}/certs/public.pem
PRIVATE_KEY_PATH=${PWD}/certs/private.pem

# music servers
SYNOLOGY_AUDIOSTATION_ENABLED=true