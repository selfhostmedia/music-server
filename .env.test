# server settings
CORS_ORIGINS=http://localhost:8100
DATABASE_PATH=":memory:"
JWT_SECRET=a-different-secret-key-for-jwt-sessions
NODE_ENV=test
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7100
SESSION_MASTER_KEY=a-secret-key-for-sessions
TZ=UTC

# authentication cert
PUBLIC_KEY_PATH=${PWD}/certs/public.pem
PRIVATE_KEY_PATH=${PWD}/certs/private.pem

# testing library
DEFAULT_ROOT_PATH=${PWD}/test-library/root-1,${PWD}/test-library/root-2

# music servers
SYNOLOGY_AUDIOSTATION_ENABLED=true
